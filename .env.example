# Copy to .env and fill in. Never commit .env.

# App
APP_ENV=dev
APP_ORIGIN=http://localhost:8120
APP_ADDR=:8120
APP_TZ=America/Fortaleza
# Comma-separated CIDRs allowed to set CF-Connecting-IP (the cloudflared peer as seen by the app).
TRUSTED_PROXY_CIDRS=

# MongoDB. MONGO_URI is a secret (it may carry credentials). The server must run
# as a single-node replica set, and the URI must always carry directConnection=true.
# The dev compose stack overrides both variables to point at its own mongo service.
MONGO_URI=
MONGO_DB=agenda

# SMTP (SMTP2GO in production; Mailpit on localhost:1025 in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=IgnisDev <ignisdev@magalz.space>
