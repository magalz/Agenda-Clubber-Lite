# Copy to .env and fill in. Never commit .env.

# App
APP_ENV=dev
APP_ORIGIN=http://localhost:8120
APP_ADDR=:8120
APP_TZ=America/Fortaleza
# Comma-separated CIDRs allowed to set CF-Connecting-IP (the cloudflared peer as seen by the app).
TRUSTED_PROXY_CIDRS=

# MongoDB. MONGO_URI is a secret (it may carry credentials). The server must run
# as a single-node replica set, and the URI must always carry directConnection=true.
# The dev compose stack overrides both variables to point at its own mongo service.
MONGO_URI=
MONGO_DB=agenda

# SMTP (SMTP2GO in production; Mailpit on localhost:1025 in dev).
# In production (APP_ENV=prod) the service refuses to start without SMTP_HOST and
# SMTP_USERNAME: TLS (STARTTLS on 587) and login are mandatory there. In dev an
# empty SMTP_USERNAME means a plain relay with no login, such as Mailpit. With no
# SMTP_HOST (and no MAIL_DROP_DIR) serve logs one warning and sends nothing; the
# queued emails wait in the outbox.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=IgnisDev <ignisdev@magalz.space>

# Dev only (refused with APP_ENV=prod): write every outgoing email as an .eml
# file in this folder instead of sending it; it wins over SMTP_HOST.
MAIL_DROP_DIR=

# Dev only: the password `agenda seed-dev` gives the sample accounts it creates.
# The command refuses to run without it, and with APP_ENV=prod.
SEED_PASSWORD=
